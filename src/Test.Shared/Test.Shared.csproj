<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Runner-agnostic Touchstone contract suites. They reference only Core and Cli, the projects under test, so every
    host (console, native AOT, xUnit v2, xUnit v3, NUnit, MSTest) can run them. Adapter contract suites live in the
    Test.Shared.{Adapter} projects because xUnit v2 and v3 cannot share a project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Touchstone.Core\Touchstone.Core.csproj" />
    <ProjectReference Include="..\Touchstone.Cli\Touchstone.Cli.csproj" />
  </ItemGroup>

</Project>
