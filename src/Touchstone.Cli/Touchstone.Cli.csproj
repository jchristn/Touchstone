<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TouchstoneShipping>true</TouchstoneShipping>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Console test runner for Touchstone. Tabular console output, command-line filtering, JSON results (schema 1.0, included in the package), offline HTML reports, and stable exit codes.</Description>
    <PackageTags>testing;test-runner;console;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Touchstone.Core\Touchstone.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo-black.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\schemas\touchstone-results-1.0.schema.json" Pack="true" PackagePath="schemas\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\touchstone-results-1.0.schema.json" LogicalName="Touchstone.Cli.touchstone-results-1.0.schema.json" />
  </ItemGroup>

</Project>
