<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs every Test.Shared suite as a native AOT binary. CI publishes it on Linux, Windows, and macOS and runs the
    published executable; a JIT run of this project does not count as an AOT run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Test.Shared\Test.Shared.csproj" />
    <ProjectReference Include="..\Touchstone.Cli\Touchstone.Cli.csproj" />
  </ItemGroup>

</Project>
