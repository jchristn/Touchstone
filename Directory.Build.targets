<Project>

  <!-- Shipping packages track their public API. Set TouchstoneShipping in each packed project. -->
  <ItemGroup Condition="'$(TouchstoneShipping)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TouchstoneShipping)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0026;RS0036;RS0037</WarningsAsErrors>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Fail the pack on any breaking change against the published release. Raise this after each release. -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
